<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.marcos2872.fingerprint-manager" path="/io/github/marcos2872/fingerprint-manager/">
    <key name="refresh" type="i">
      <range min="5" max="120"/>
      <default>30</default>
      <summary>Intervalo de atualização (s)</summary>
      <description>Intervalo para recarregar lista de digitais e estado PAM.</description>
    </key>
    <key name="device-path" type="s">
      <default>'auto'</default>
      <summary>Dispositivo fprintd</summary>
      <description>'auto' usa GetDefaultDevice ou o primeiro de GetDevices.</description>
    </key>
  </schema>
</schemalist>
